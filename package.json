    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply orbe-planner-db --local",
    "db:remote": "wrangler d1 migrations apply orbe-planner-db --remote"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@cloudflare/workers-types": "^4.20261121.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.48.0"
  }
}
